# Optional. If set, contact form mail goes out through Resend.
RESEND_API_KEY=

# Inbox that should receive inquiries.
CONTACT_TO_EMAIL=hello@epignos.dev

# Must be a verified sender in Resend. The onboarding address works for tests.
CONTACT_FROM_EMAIL=Epignos <no-reply@notify.epignos.dev>

# Optional fallback if you are not using Resend yet. https://web3forms.com
WEB3FORMS_ACCESS_KEY=
