---
import { hero } from "../content";
---

<section class="hero" aria-labelledby="hero-heading">
  <p class="eyebrow">{hero.kicker}</p>
  <h1 id="hero-heading">{hero.headline}</h1>
  <p class="lede">{hero.lede}</p>
  <div class="hero-actions">
    <a class="button" href={hero.primaryHref}>{hero.primaryCta}</a>
    <a class="button button-secondary" href={hero.secondaryHref}>{hero.secondaryCta}</a>
  </div>
</section>
