---
import { contact } from "../content";
---

<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="wrap contact-grid">
    <div class="section-head">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 id="contact-heading">{contact.title}</h2>
      <p class="section-intro">{contact.intro}</p>
    </div>

    <div class="contact-panel" id="contact-panel">
      <div id="contact-success" class="form-status" data-kind="ok" hidden tabindex="-1">
        {contact.success}
      </div>

      <form id="contact-form" method="post" action="/api/contact" novalidate>
        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field">
          <label for="name">{contact.nameLabel}</label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>

        <div class="field">
          <label for="email">{contact.emailLabel}</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>

        <div class="field">
          <label for="message">{contact.messageLabel}</label>
          <textarea id="message" name="message" required maxlength="4000"></textarea>
        </div>

        <p class="form-note">{contact.note}</p>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        <button type="submit">{contact.submit}</button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const panel = document.getElementById("contact-panel");
  const statusEl = document.getElementById("form-status");
  const successEl = document.getElementById("contact-success");
  const button = form?.querySelector("button[type='submit']") as HTMLButtonElement | null;

  const copy = {
    submit: "Send",
    sending: "Sending…",
    success: "Sent. I’ll read it and reply.",
    error: "Something went wrong. Email hello@epignos.dev instead.",
  };

  function setStatus(kind: "ok" | "err" | "", text: string) {
    if (!statusEl) return;
    statusEl.dataset.kind = kind;
    statusEl.textContent = text;
  }

  function showSuccess() {
    panel?.classList.add("is-sent");
    if (form) form.hidden = true;
    if (successEl) {
      successEl.hidden = false;
      successEl.focus();
    }
    setStatus("", "");
  }

  const params = new URLSearchParams(window.location.search);
  if (params.get("sent") === "1") showSuccess();
  if (params.get("error") === "1") setStatus("err", copy.error);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !button) return;

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();
    const website = String(data.get("website") ?? "").trim();

    if (!name || !email || !message) {
      setStatus("err", "Name, email, and a short note are required.");
      return;
    }

    button.disabled = true;
    button.textContent = copy.sending;
    setStatus("", "");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ name, email, message, website }),
      });

      const payload = (await response.json().catch(() => ({}))) as { ok?: boolean };

      if (!response.ok || !payload.ok) {
        throw new Error("request failed");
      }

      form.reset();
      showSuccess();
    } catch {
      setStatus("err", copy.error);
    } finally {
      button.disabled = false;
      button.textContent = copy.submit;
    }
  });
</script>
