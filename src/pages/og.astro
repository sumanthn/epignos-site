---
import { hero, site } from "../content";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG — {site.name}</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #f7f7f2;
        color: #172033;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      }
      .og {
        box-sizing: border-box;
        width: 1200px;
        height: 630px;
        padding: 72px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #f7f7f2;
      }
      .mark {
        font-size: 32px;
        font-weight: 750;
        letter-spacing: -0.04em;
      }
      .mark span {
        color: #697386;
        font-size: 18px;
        font-weight: 600;
        margin-left: 4px;
      }
      h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 88px;
        line-height: 0.98;
        font-weight: 500;
        letter-spacing: -0.045em;
      }
      .foot {
        color: #697386;
        font-size: 22px;
      }
    </style>
  </head>
  <body>
    <div class="og">
      <div class="mark">{site.name}<span>.dev</span></div>
      <h1>{hero.headline}</h1>
      <div class="foot">EpiNote · {site.domain}</div>
    </div>
  </body>
</html>
